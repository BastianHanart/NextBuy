    "# 7) Pourcentage de meme articles acheter quand un client va racheter dans le magasin"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ea4306b4",
   "metadata": {},
   "source": [
    "### Which aisle and departement have the most (less) preoducts"
   "id": "b4530d3f-86d4-4998-830d-0d228004daca",
   "metadata": {},
   "source": [
    "## Preparation des datas"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eea335d4",
   "metadata": {},
   "source": [
    "##### Preparation des datas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9d6b412f",
   "metadata": {},
   "outputs": [],
   "source": [
    "listeaisle = {}\n",
    "\n",
    "# On fait un boucle qui parcour tout DF et on ajoute chaque nouvelle allée en clé si elle n'existe pas et on augmente sa valeur qui \n",
    "# correspond au nombre de fois ou cette allée apparait dans le CSV\n",
    "for k in CSV_untouch[\"aisle\"]:\n",
    "    if k not in listeaisle:\n",
    "         listeaisle[k] = 1\n",
    "    else:\n",
    "        listeaisle[k] += 1"
   "execution_count": 45,
   "id": "7c4fe4f9-35ce-45fd-92bf-b14ccf1d4218",
   "metadata": {},
   "outputs": [],
   "source": [
    "# on va faire un groupy pour chaque user_id\n",
    "CSV_Clean = CSV_untouch.groupby(\"user_id\").agg(\n",
    "    # lst_unique=(\"product_name\", \"unique\"),  # on va prendre la liste des objets achete sans doublon\n",
    "    nbr_unique=(\"product_name\", \"nunique\"),    # on va prendre la taille de la liste d'objet unique\n",
    "    total_achat=(\"product_name\", \"count\")     # on va prendre le nombre total d'objets/ items acheter y compris les doublons\n",
    ")\n",
    "\n",
    "# on connait maintenant le nombre d'items acheter et le nombre d'items acheter qui sont unique, par consequent le nombre d'items racheter c'est le nombre total - le nombre unique\n",
    "# on va donc calculer mathematiquement en faisant :\n",
    "\n",
    "# (Total des achats - items uniques) = Nombre d'itenms racheter\n",
    "# Pourcentage -> = (Nombre de rachats / Total des achats) * 100\n",
    "DataFrameRachat = pd.DataFrame()\n",
    "DataFrameRachat['taux_rachat_%'] = ((CSV_Clean['total_achat'] - CSV_Clean['nbr_unique']) / CSV_Clean['total_achat']) * 100\n",
    "\n",
    "\n",
    "\n",
    "Pourcentage_rachat = DataFrameRachat['taux_rachat_%'].mean()\n"
   ]
  },
